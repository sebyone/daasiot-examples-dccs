{
    "name": "daas-iot-sdk-node",
    "version": "1.0.0",
    "description": "DaaS-IoT HTTP and WebSocket backend",
    "main": "src/server.js",
    "engines": {
        "node": ">=20.19.0 <21",
        "npm": ">=10.8.0 <12"
    },
    "scripts": {
        "start": "cross-env NODE_ENV=production node src/server.js",
        "dev": "cross-env NODE_ENV=development nodemon src/server.js",
        "start:sender": "cross-env NODE_ENV=production node src/sender.js",
        "dev:sender": "cross-env NODE_ENV=development nodemon src/sender.js",
        "build": "npm run check",
        "check": "eslint src test && node --check src/server.js",
        "test": "node --test",
        "smoke": "cross-env NODE_ENV=development node scripts/smoke.js",
        "db:migrate": "cross-env NODE_ENV=development sequelize-cli db:migrate",
        "db:seed": "cross-env NODE_ENV=development sequelize-cli db:seed:all",
        "db:reset": "cross-env NODE_ENV=development sequelize-cli db:migrate:undo:all"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "daas-sdk": "file:vendor/daas-sdk-0.22.0.tgz",
        "ejs": "^3.1.10",
        "express": "^5.2.1",
        "morgan": "^1.11.0",
        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1",
        "swagger-ui-express": "^5.0.1",
        "ws": "^8.21.1",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.7.0",
        "globals": "^17.0.0",
        "nodemon": "^3.1.14",
        "sequelize-cli": "^6.6.2"
    },
    "overrides": {
        "brace-expansion": "^1.1.13"
    }
}
